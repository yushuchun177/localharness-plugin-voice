{
  "id": "voice",
  "name": "语音输入",
  "name_en": "Voice",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "description": "朗读回答（Windows 中文语音）；也能录一段麦克风并尝试用系统语音识别转成文字。",
  "description_en": "Speak answers aloud (Windows voices) and record the mic, transcribing it with the system speech recognizer when available.",
  "author": "yushuchun177",
  "homepage": "https://github.com/yushuchun177/localharness-plugin-voice",
  "min_app": "0.1.0",
  "requires": {
    "os": "Windows 10+",
    "deps": [
      "PowerShell",
      "系统语音包"
    ],
    "disk": "每次录音几百 KB",
    "memory": "约 10 MB",
    "network": false
  },
  "settings": [
    {
      "key": "rate",
      "label": "朗读语速",
      "type": "int",
      "default": 0,
      "help": "-10 慢 … 10 快",
      "min": -10,
      "max": 10,
      "unit": ""
    },
    {
      "key": "seconds",
      "label": "默认录音秒数",
      "type": "int",
      "default": 5,
      "help": "",
      "min": 1,
      "max": 30,
      "unit": "秒"
    }
  ],
  "commands": [
    {
      "name": "say",
      "description": "朗读一段文字",
      "usage": "/say 你好"
    }
  ],
  "tools": [
    {
      "name": "voice_speak",
      "description": "用系统语音朗读一段文字（离线，中文一般自带 Huihui）。",
      "params": {
        "text": "string，要朗读的文字",
        "rate": "int，可选，语速 -10..10，默认 0"
      },
      "level": "act",
      "needs": [
        "扬声器"
      ],
      "async": true
    },
    {
      "name": "voice_voices",
      "description": "列出这台机器上装了的语音合成声音。",
      "params": {},
      "level": "read",
      "needs": [
        "系统语音"
      ]
    },
    {
      "name": "voice_listen",
      "description": "录一段麦克风并尝试转成文字（需要系统装了对应语言的语音识别）。",
      "params": {
        "seconds": "int，可选，录音秒数，默认 5"
      },
      "level": "act",
      "needs": [
        "麦克风"
      ],
      "async": true
    }
  ]
}
